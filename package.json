{
  "name": "wulin-self-created-arts",
  "version": "0.1.0",
  "private": true,
  "description": "《武林·自创绝学》规则引擎与无界面模拟器",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "artifact": "npm run build && node scripts/build-artifact.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "matrix": "node scripts/run-matrix.ts",
    "experiment3": "node scripts/run-experiment-3.ts",
    "experiment4": "node scripts/run-experiment-4.ts",
    "walk-lessons": "node scripts/walk-lessons.ts",
    "affix-matrix": "node scripts/run-affix-matrix.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "3.23.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "dependencies": {
    "preact": "10.29.8"
  }
}
